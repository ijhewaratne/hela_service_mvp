# Copy to .env for local overrides. Never commit real secrets; staging/production refuse the dev defaults.
HELA_ENV=dev
HELA_DATABASE_URL=postgresql+psycopg://hela_app:hela_app_dev_only@127.0.0.1:55432/hela
HELA_REDIS_URL=redis://127.0.0.1:56379/0
# HELA_JWT_SECRET=<48+ random chars>
# HELA_FIELD_KEY_B64=<base64 of 32 random bytes>
# HELA_LOOKUP_KEY_B64=<base64 of 32 random bytes>
# HELA_DEV_INBOX_TOKEN=<local-only token for the sandbox SMS inbox>
