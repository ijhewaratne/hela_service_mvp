  "components": {
    "schemas": {
      "ApprovalInput": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "denied",
              "revoked"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "category",
          "decision",
          "reason"
        ],
        "title": "ApprovalInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "service_quality",
              "safety",
              "payment_dispute",
              "other"
            ],
            "title": "Kind"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 15,
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "severity",
          "description"
        ],
        "title": "IncidentInput"
      },
      "ServiceRequestInput": {
        "properties": {
          "address_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Address Id"
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Category"
          },
          "task_details": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Task Details"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "title": "End At"
          }
        },
        "type": "object",
