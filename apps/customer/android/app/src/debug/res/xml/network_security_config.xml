<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the developer's machine as seen from the Android emulator. Release builds
     keep the platform default (cleartext blocked) and must talk to the API over TLS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
